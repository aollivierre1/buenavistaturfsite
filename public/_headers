# Netlify response headers. Lives in the publish root; Astro copies public/ to dist/.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()

# Astro fingerprints these filenames, so a changed file gets a new name.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Photo filenames carry a content hash from the original library, and the
# generated derivatives inherit it. Long cache, but not immutable — a replaced
# source file would reuse its name.
/images/*
  Cache-Control: public, max-age=2592000

# Root-level static assets. Without these they fall through to Netlify default
# no-cache, so the social card and favicons were refetched on every view.
/og.jpg
  Cache-Control: public, max-age=2592000

/favicon.png
  Cache-Control: public, max-age=2592000

/favicon-32.png
  Cache-Control: public, max-age=2592000

/apple-touch-icon.png
  Cache-Control: public, max-age=2592000

# HTML must revalidate, or a deploy would not reach people already on the site.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate
