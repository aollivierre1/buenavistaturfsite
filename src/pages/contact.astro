---
import Base from '../layouts/Base.astro';
import { site } from '../data/site.js';
import { locations } from '../data/locations.js';
---
<Base title="Contact Us" description="Call or message Buena Vista Turf Farm. Serving Dallas-Fort Worth and North Texas from four farm locations.">
  <section class="ph"><div class="wrap">
    <span class="eyebrow">Contact</span>
    <h1>Talk to someone who knows the field.</h1>
    <p class="lede">Call for the fastest answer, or send a message and we will get back to you — usually the same business day.</p>
  </div></section>
  <section><div class="wrap cols">
    <form name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/thanks">
      <input type="hidden" name="form-name" value="contact" />
      <p hidden><label>Leave blank: <input name="bot-field" /></label></p>
      <div class="two">
        <div><label for="cn">Name</label><input id="cn" type="text" name="name" required /></div>
        <div><label for="cp">Phone</label><input id="cp" type="tel" name="phone" required /></div>
      </div>
      <label for="ce">Email</label><input id="ce" type="email" name="email" required />
      <label for="ct">What do you need?</label>
      <select id="ct" name="topic">
        <option>Sod pricing or availability</option>
        <option>Delivery scheduling</option>
        <option>Grass selection help</option>
        <option>Existing order</option>
        <option>Something else</option>
      </select>
      <label for="cm">Message</label><textarea id="cm" name="message" rows="6" required></textarea>
      <button type="submit" class="btn" style="width:100%">Send Message</button>
    </form>
    <aside class="card" style="align-self:start">
      <h3>Call us</h3>
      <p><a href={site.phoneHref} style="font-family:var(--font-display);font-size:1.9rem;font-weight:800;color:var(--gold);text-decoration:none">{site.phone}</a></p>
      <h4 style="margin-top:28px;font-size:.72rem;letter-spacing:.13em;text-transform:uppercase;color:var(--muted)">Farm locations</h4>
      <ul class="specs">
        {locations.map((l) => <li><span>{l.name}</span><span>{l.county}</span></li>)}
      </ul>
      <a href="/quote" class="btn" style="margin-top:24px;width:100%;text-align:center">Build a Quote Instead</a>
    </aside>
  </div></section>
</Base>
<style>
  .ph{background:linear-gradient(135deg,#24462c,#0f1f12);padding:clamp(60px,9vw,120px) 0}
  .cols{display:grid;gap:44px}
  @media(min-width:940px){.cols{grid-template-columns:1.6fr 1fr}}
  .two{display:grid;grid-template-columns:1fr 1fr;gap:18px}
</style>
