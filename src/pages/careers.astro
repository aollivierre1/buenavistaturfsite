---
import Base from '../layouts/Base.astro';
import { locations } from '../data/locations.js';
import { openings, roleCategories } from '../data/openings.js';

// Posted roles head the dropdown; drop any generic category a posted role
// already covers so the same job is not offered twice under two names. The same
// role posted at two sites is one dropdown entry - the location field below
// records which site.
const postedTitles = [...new Set(openings.map((o) => o.title))];
const posted = new Set(postedTitles.map((t) => t.toLowerCase()));
const otherCategories = roleCategories.filter((r) => !posted.has(r.toLowerCase()));

// Applicants must be able to pick the place they are applying to. A site that is
// not one of the public farm locations - the corporate office, say - names its
// own form option, rather than the option being guessed from a display label.
const farmLocations = locations.map((l) => `${l.name}, ${l.county}`);
const otherLocations = [...new Set(openings.map((o) => o.locationOption).filter(Boolean))];
---
<Base title="Careers" description="Join a family-run North Texas turf farm. Field, harvest, delivery, and office roles across Ravenna, Ivanhoe, Collinsville, and Ferris.">
  <section class="ph"><div class="wrap">
    <span class="eyebrow">Careers</span>
    <h1>Work where people stay.</h1>
    <p class="lede">Our average staff longevity is over 25 years. That is not an accident — it is how we run the place.</p>
  </div></section>
  <section id="openings" hidden={openings.length === 0}><div class="wrap">
    <span class="eyebrow">Open roles</span>
    <h2>What we are hiring for right now.</h2>
    <div class="roles" id="rolesList">
      {openings.map((o) => {
        // Roles written up in full get their own page; the rest go straight to
        // the form with the role preselected.
        const detail = o.slug && o.sections?.length ? `/careers/${o.slug}/` : null;
        const where = [o.location, o.type].filter(Boolean).join(' \u00b7 ');
        return (
          <a class="role" href={detail || '#apply'} data-role={detail ? null : o.title}>
            <h3>{o.title}</h3>
            {where && <span class="where">{where}</span>}
            {o.summary && <p>{o.summary}</p>}
            <span class="role-cta">{detail ? 'View role & apply' : 'Apply for this role'} &rarr;</span>
          </a>
        );
      })}
    </div>
  </div></section>

  <section id="apply"><div class="wrap cols">
    <form name="application" method="POST" data-netlify="true" netlify-honeypot="bot-field" enctype="multipart/form-data" action="/thanks">
      <input type="hidden" name="form-name" value="application" />
      <p hidden><label>Leave blank: <input name="bot-field" /></label></p>
      <div class="two">
        <div><label for="an">Full name</label><input id="an" type="text" name="name" required /></div>
        <div><label for="ap">Phone</label><input id="ap" type="tel" name="phone" required /></div>
      </div>
      <label for="ae">Email</label><input id="ae" type="email" name="email" required />
      <label for="al">Which location?</label>
      <select id="al" name="location" required>
        {farmLocations.map((l) => <option>{l}</option>)}
        {otherLocations.map((l) => <option>{l}</option>)}
        <option>Any / wherever needed</option>
      </select>
      <label for="ar">Role you are interested in</label>
      <select id="ar" name="role">
        {postedTitles.map((t) => <option>{t}</option>)}
        {otherCategories.map((r) => <option>{r}</option>)}
      </select>
      <label for="ax">Relevant experience</label>
      <textarea id="ax" name="experience" rows="5" placeholder="Farm, landscape, equipment, CDL, or anything else you want us to know."></textarea>
      <label for="af">Resume (optional)</label>
      <input id="af" type="file" name="resume" accept=".pdf,.doc,.docx" />
      <button type="submit" class="btn" style="width:100%">Submit Application</button>
      <p style="font-size:.84rem;color:var(--muted);text-align:center">Applications go straight to the hiring manager.</p>
    </form>
    <aside class="card" style="align-self:start">
      <h2>What we look for</h2>
      <p>Show up, work safe, take care of the equipment, and treat the customer's property like your own. We will train the rest.</p>
      <ul class="specs">
        <li><span>Longevity</span><span>25+ yrs average</span></li>
        <li><span>Locations</span><span>4 farms</span></li>
        <li><span>Ownership</span><span>Family-run</span></li>
      </ul>
    </aside>
  </div></section>
</Base>

<script>
  // Roles render server-side from src/data/openings.js. Roles posted from /admin
  // are served by /api/openings and replace that list here, so posting or closing
  // one needs no code change. If the endpoint is unavailable the page simply keeps
  // the roles it was built with.
  const rolesList = document.getElementById('rolesList');
  const roleSelect = document.getElementById('ar');

  // Clicking a role card sends the applicant to the form with that role chosen.
  function selectRole(title) {
    if (!roleSelect || !title) return;
    const want = title.trim().toLowerCase();
    let opt = Array.from(roleSelect.options).find(
      (o) => o.textContent.trim().toLowerCase() === want
    );
    if (!opt) {
      opt = document.createElement('option');
      opt.textContent = title;
      roleSelect.insertBefore(opt, roleSelect.firstChild);
    }
    opt.selected = true;
    roleSelect.classList.add('picked');
    setTimeout(() => roleSelect.classList.remove('picked'), 1400);
  }

  function bindRoleCards() {
    if (!rolesList) return;
    for (const card of rolesList.querySelectorAll('[data-role]')) {
      card.addEventListener('click', () => selectRole(card.dataset.role));
    }
  }
  bindRoleCards();

  // Arriving from a job page: /careers/?role=<title>&location=<site>#apply
  const params = new URLSearchParams(location.search);
  const wantedRole = params.get('role');
  if (wantedRole) selectRole(wantedRole);

  // Only an exact match; a county covering two farms stays the applicant's choice.
  const wantedPlace = params.get('location');
  if (wantedPlace) {
    const sel = document.getElementById('al');
    const opt = sel && Array.from(sel.options).find(
      (o) => o.textContent.trim().toLowerCase() === wantedPlace.trim().toLowerCase()
    );
    if (opt) opt.selected = true;
  }

  (async () => {
    let openings = [];
    try {
      const res = await fetch('/api/openings');
      if (res.ok) openings = (await res.json()).openings || [];
    } catch { /* stay with the roles the page was built with */ }
    if (!openings.length || !rolesList) return;

    const esc = (t) => String(t ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));

    rolesList.innerHTML = openings.map((o) => {
      const where = [o.location, o.type].filter(Boolean).join(' \u00b7 ');
      return '<a class="role" href="#apply" data-role="' + esc(o.title) + '">' +
        '<h3>' + esc(o.title) + '</h3>' +
        (where ? '<span class="where">' + esc(where) + '</span>' : '') +
        (o.summary ? '<p>' + esc(o.summary) + '</p>' : '') +
        '<span class="role-cta">Apply for this role \u2192</span></a>';
    }).join('');
    document.getElementById('openings').hidden = false;
    bindRoleCards();

    // Posted roles head the dropdown, keeping the generic categories underneath
    // for speculative applications.
    if (roleSelect) {
      const seen = new Set();
      const titles = openings.map((o) => o.title).filter((t) => t && !seen.has(t) && seen.add(t));
      const live = new Set(titles.map((t) => t.toLowerCase()));
      for (const o of Array.from(roleSelect.options)) {
        if (live.has(o.textContent.trim().toLowerCase())) o.remove();
      }
      for (const t of titles.slice().reverse()) {
        const opt = document.createElement('option');
        opt.textContent = t;
        roleSelect.insertBefore(opt, roleSelect.firstChild);
      }
      roleSelect.selectedIndex = 0;
    }
  })();
</script>
<style>
  .roles { display: grid; gap: 14px; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); margin-top: 40px; }
  .role { display: block; border: 1px solid var(--line); background: var(--green-700); padding: 24px 26px;
    color: inherit; text-decoration: none; transition: border-color .15s, background .15s, transform .15s; }
  .role:hover, .role:focus-visible { border-color: var(--green-400, #3fae5f); background: var(--green-600, #1c3d24); transform: translateY(-2px); }
  .role:focus-visible { outline: 2px solid var(--gold); outline-offset: 3px; }
  .role h3 { margin-bottom: 6px; }
  .role .where { display: block; color: var(--gold); font-size: .68rem; letter-spacing: .15em; text-transform: uppercase; margin-bottom: 12px; }
  .role p { color: var(--cream-dim); font-size: .93rem; margin: 0; }
  .role-cta { display: inline-block; margin-top: 16px; color: var(--green-400, #3fae5f);
    font-size: .72rem; letter-spacing: .14em; text-transform: uppercase; font-weight: 700; }
  .role:hover .role-cta { text-decoration: underline; }

  /* brief cue that the click landed on the right dropdown */
  #ar.picked { outline: 2px solid var(--gold); outline-offset: 2px; }

  .ph{background:linear-gradient(135deg,#24462c,#0f1f12);padding:clamp(60px,9vw,120px) 0;padding-top: calc(var(--topbar-h, 132px) + clamp(36px, 5vw, 72px));}
  .cols{display:grid;gap:44px}
  @media(min-width:940px){.cols{grid-template-columns:1.6fr 1fr}}
  .two{display:grid;grid-template-columns:1fr 1fr;gap:18px}
</style>
