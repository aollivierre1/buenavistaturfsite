<script>
  for (const [input, out] of [['resume', 'resumePicked'], ['licence_photo', 'licencePicked']]) {
    const el = document.getElementById(input);
    const note = document.getElementById(out);
    el?.addEventListener('change', () => {
      const f = el.files && el.files[0];
      note.hidden = !f;
      if (f) note.textContent = 'Attached: ' + f.name + ' (' + Math.round(f.size / 1024) + ' KB)';
    });
  }
