---
import Base from '../../layouts/Base.astro';
import { openings } from '../../data/openings.js';

// Only roles written up in full get a page of their own. The rest link straight
// to the application form from the Careers index.
export function getStaticPaths() {
  return openings
    .filter((o) => o.slug && o.sections?.length)
    .map((o) => ({ params: { slug: o.slug }, props: { role: o } }));
}

const { role } = Astro.props;
const where = [role.locations?.join(', '), role.type].filter(Boolean).join(' · ');
// Two sites can post the same role, so the location travels with it.
const applyQuery = new URLSearchParams({ role: role.title });
if (role.locationOption) applyQuery.set('location', role.locationOption);
// Non-driving roles go to the full General Labor packet, filled in and signed
// online. The CDL packet is a different set of forms and is not built yet, so
// that role still goes to the short form on the Careers page.
const isDriver = /cdl|driver/i.test(role.title);
const applyHref = isDriver ? `/careers/?${applyQuery}#apply` : `/apply/general/?${applyQuery}`;
---
<Base
  title={`${role.title} — Careers`}
  description={role.summary || role.about}
>
  <section class="ph"><div class="wrap">
    <a class="back" href="/careers/">&larr; All open roles</a>
    <span class="eyebrow" id="jdEyebrow">Now hiring</span>
    <h1>{role.title}</h1>
    {where && <p class="where">{where}</p>}
    {role.summary && <p class="lede">{role.summary}</p>}
    <p class="closed" id="jdClosed" hidden>This role has been filled and is no longer taking
      applications. <a href="/careers/">See what else is open &rarr;</a></p>
    <a class="btn" id="jdApplyTop" href={applyHref}>Apply for this role</a>
  </div></section>

  <section><div class="wrap jd">
    {role.about && (
      <>
        <h2>About us</h2>
        <p>{role.about}</p>
      </>
    )}

    <h2>Key responsibilities</h2>
    {role.sections.map((s) => (
      <div class="block">
        <h3>{s.heading}</h3>
        <ul>{s.items.map((i) => <li>{i}</li>)}</ul>
      </div>
    ))}

    {role.requirements?.length > 0 && (
      <div class="block">
        <h2>Requirements</h2>
        <ul>{role.requirements.map((r) => <li>{r}</li>)}</ul>
      </div>
    )}

    {role.notes?.length > 0 && (
      <p class="note">{role.notes.join(' ')}</p>
    )}

    <div class="cta">
      <h2>Ready to apply?</h2>
      <p>The form takes a couple of minutes. Applications go straight to the hiring manager.</p>
      <a class="btn" id="jdApplyBottom" href={applyHref}>Apply for this role</a>
    </div>
  </div></section>
</Base>

<style>
  .ph{background:linear-gradient(135deg,#24462c,#0f1f12);padding:clamp(60px,9vw,120px) 0;
    padding-top: calc(var(--topbar-h, 132px) + clamp(36px, 5vw, 72px));}
  .back{display:block;width:fit-content;margin-bottom:26px;color:var(--cream-dim);text-decoration:none;
    font-size:.78rem;letter-spacing:.12em;text-transform:uppercase}
  .back:hover{color:var(--cream)}
  .ph .where{color:var(--gold);font-size:.72rem;letter-spacing:.15em;text-transform:uppercase;margin:10px 0 0}
  .ph .lede{margin-top:18px}
  .ph .btn{margin-top:32px}

  .jd{max-width:820px}
  .jd h2{margin-top:8px}
  .jd > p{color:var(--cream-dim)}
  .block{margin-top:38px}
  .block h3{font-size:1.05rem;margin-bottom:14px;color:var(--cream)}
  .jd ul{margin:0;padding-left:20px;display:grid;gap:9px}
  .jd li{color:var(--cream-dim);font-size:.95rem;line-height:1.55}
  .note{margin-top:34px;padding:14px 18px;border-left:3px solid var(--gold);
    background:var(--green-700);color:var(--cream-dim);font-size:.9rem}
  .closed{margin:0 0 24px;padding:14px 18px;border-left:3px solid var(--gold);
    background:rgba(216,178,94,.1);color:var(--cream);max-width:60ch}
  .closed a{color:var(--gold)}
  .cta{margin-top:56px;padding-top:40px;border-top:1px solid var(--line)}
  .cta p{color:var(--cream-dim);margin-bottom:24px}

  /* Printed, a posting should read as a plain job description on white paper -
     no site chrome, no apply buttons, and tight enough to stay within two pages. */
  @media print {
    :global(html), :global(body) { background:#fff !important; color:#111 !important }
    :global(.topbar), :global(.weatherbar), :global(.hdr), :global(.ft), :global(.skip) { display:none !important }
    .back, .eyebrow, .cta, .ph .btn { display:none !important }

    .ph { background:none !important; padding:0 0 10pt !important }
    .ph h1 { font-size:20pt; line-height:1.15; margin:0 }
    .ph .where { color:#444 !important; margin:6pt 0 0; font-size:8pt }
    .ph .lede { color:#222 !important; font-size:10pt; margin-top:8pt }

    .jd { max-width:none }
    .jd h2 { font-size:12pt; margin:14pt 0 4pt }
    .jd > p { color:#222 !important; font-size:9.5pt; margin:0 }
    .block { margin-top:10pt; break-inside:avoid }
    .block h3 { font-size:10pt; color:#111 !important; margin-bottom:4pt }
    .jd ul { gap:2pt; padding-left:14pt }
    .jd li { color:#222 !important; font-size:9.5pt; line-height:1.3 }
    .note { margin-top:12pt; padding:6pt 9pt; background:none !important;
      border-left:2pt solid #888; color:#222 !important; font-size:9pt }
  }
</style>

<script define:vars={{ slug: role.slug }}>
  // This page is built once and stays built, so a role taken down in /admin
  // would otherwise keep taking applications for anyone holding the link.
  // Ask the live list; if it cannot be reached, leave the page as it is rather
  // than telling someone a job is closed because a request failed.
  fetch('/api/openings')
    .then((r) => (r.ok ? r.json() : null))
    .then((d) => {
      if (!d || !Array.isArray(d.openings)) return;
      const open = d.openings.some((o) => o.slug === slug || o.title === document.querySelector('h1').textContent.trim());
      if (open) return;
      document.getElementById('jdClosed').hidden = false;
      document.getElementById('jdEyebrow').textContent = 'Closed';
      for (const id of ['jdApplyTop', 'jdApplyBottom']) {
        const el = document.getElementById(id);
        if (el) el.hidden = true;
      }
    })
    .catch(() => {});
</script>
