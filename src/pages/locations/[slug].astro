---
// One page per farm, at /locations/<slug>/.
//
// These exist to rank for the searches the single /locations/ page cannot:
// "sod collinsville tx", "sod delivery ferris", "turf farm near bonham". A
// search like that is made by somebody with a yard and a budget, and it is
// answered by a page that names the town, not by a page listing four towns.
//
// The danger with a set of pages like this is that they come out as four
// copies of each other with the city name swapped. Google calls that a
// doorway page and demotes the whole set, so each page leads with what is
// genuinely different about that farm - its address, its county, the towns it
// delivers to, and its own write-up - and the shared material (the grass
// catalogue, the delivery zones) sits underneath that.
import Base from '../../layouts/Base.astro';
import { locations } from '../../data/locations.js';
import { grasses } from '../../data/grasses.js';
import { site } from '../../data/site.js';
import { pricing, priceFor, money } from '../../data/pricing.js';

export function getStaticPaths() {
  return locations.map((l) => ({ params: { slug: l.slug }, props: { l } }));
}

const { l } = Astro.props;
const others = locations.filter((o) => o.slug !== l.slug);
const mapHref = `https://www.google.com/maps/search/?api=1&query=${
  encodeURIComponent(`${l.street}, ${l.city}, TX ${l.zip}`)}`;
const quoteHref = `/quote/?nearest=${encodeURIComponent(l.name)}`;

const title = `Sod in ${l.city}, TX`;
const description = `Fresh-cut Bermuda, Zoysia and St Augustine sod from our ${l.city} turf farm `
  + `in ${l.county}. Delivery across ${l.nearby.slice(0, 3).join(', ')} and North Texas. `
  + `${site.hours.display}.`;

// This farm as a place of business in its own right, so a search for the town
// can surface this page rather than the company's primary address.
const placeSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': new URL(`/locations/${l.slug}/`, site.url).href,
  name: `${site.name} — ${l.city}`,
  description: l.blurb,
  url: new URL(`/locations/${l.slug}/`, site.url).href,
  image: new URL('/og.jpg', site.url).href,
  telephone: site.phone,
  parentOrganization: { '@type': 'Organization', name: site.name, url: site.url },
  address: {
    '@type': 'PostalAddress',
    streetAddress: l.street,
    addressLocality: l.city,
    addressRegion: 'TX',
    postalCode: l.zip,
    addressCountry: 'US',
  },
  openingHoursSpecification: [{
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: site.hours.days,
    opens: site.hours.opens,
    closes: site.hours.closes,
  }],
  areaServed: [l.county, ...l.nearby].map((a) => ({ '@type': 'Place', name: a })),
};
---
<Base title={title} description={description} extraSchema={placeSchema}>
  <section class="ph"><div class="wrap">
    <a class="back" href="/locations/">&larr; All four farms</a>
    <span class="eyebrow">{l.county}</span>
    <h1>Sod delivered from our {l.city} farm.</h1>
    <p class="lede">{l.blurb}</p>
    <div class="cta">
      <a href={quoteHref} class="btn">Get a quote from {l.city}</a>
      <a href={site.phoneHref} class="btn btn-ghost">{site.phone}</a>
    </div>
  </div></section>

  <section><div class="wrap cols">
    <article>
      <h2>Where we deliver from {l.city}</h2>
      <p>
        The {l.city} farm covers {l.county} and the surrounding area. If your job site
        is near any of these, this is usually the field your pallets are cut from:
      </p>
      <ul class="towns">{l.nearby.map((t) => <li>{t}</li>)}</ul>
      <p>
        Not on the list? We deliver across Dallas-Fort Worth and North Texas, and we will
        route your order to whichever of our four farms is closest to you.{' '}
        <a href={site.phoneHref}>Call {site.phone}</a> and we will tell you which one that is.
      </p>

      <h2>Delivery and pickup</h2>
      <ul class="zones">
        {pricing.deliveryZones.map((z) => (
          <li><strong>{z.label}</strong>{z.note && <span> — {z.note}</span>}</li>
        ))}
      </ul>
      <p class="appt">
        <strong>{site.hours.pickup}.</strong> Sod is perishable and cut to order, so pickups
        are scheduled rather than walk-in — call ahead and we will have your pallets ready.
      </p>

      <h2>Grass we grow</h2>
      <p>
        Every variety is available from {l.city}. Prices are per square foot and per pallet
        ({pricing.sqftPerPallet} sq ft), sod only — delivery is quoted separately.
      </p>
      <ul class="glist">
        {grasses.map((g) => {
          const p = priceFor(g.slug);
          return (
            <li>
              <a href={`/grasses/${g.slug}/`}>{g.name}</a>
              <span class="gsun">{g.sun}</span>
              {p && <span class="gprice">{money(p.perSqFt)}/sq ft · {money(p.perPallet)}/pallet</span>}
            </li>
          );
        })}
      </ul>
      <p>
        Not sure which one suits your yard? The <a href="/grasses/">selection guide</a> compares
        them on sun, shade and traffic, and <a href="/turf-tips/">Turf Tips</a> covers laying
        and watering once it arrives.
      </p>
    </article>

    <aside class="card" style="position:sticky;top:110px">
      <h3>{l.city} farm</h3>
      <address>
        <a href={mapHref} target="_blank" rel="noopener">
          {l.street}<br />{l.city}, TX {l.zip}
        </a>
      </address>
      <ul class="specs">
        <li><span>County</span><span>{l.county}</span></li>
        <li><span>Hours</span><span>{site.hours.display}</span></li>
        <li><span>Pickup</span><span>By appointment</span></li>
        <li><span>Phone</span><span><a href={site.phoneHref}>{site.phone}</a></span></li>
      </ul>
      <a href={quoteHref} class="btn" style="margin-top:22px;width:100%;text-align:center">
        Build a quote
      </a>
      <h4>Our other farms</h4>
      <ul class="others">
        {others.map((o) => (
          <li><a href={`/locations/${o.slug}/`}>{o.name}</a> <span>{o.county}</span></li>
        ))}
      </ul>
    </aside>
  </div></section>
</Base>

<style>
  .ph{background:linear-gradient(135deg,#24462c,#0f1f12);padding:clamp(60px,9vw,120px) 0;
      padding-top:calc(var(--topbar-h, 132px) + clamp(36px, 5vw, 72px));}
  .back{display:block;margin-bottom:18px;color:var(--muted);text-decoration:none;font-size:.9rem}
  .back:hover{color:var(--gold)}
  .cta{display:flex;flex-wrap:wrap;gap:12px;margin-top:28px}
  .cols{display:grid;gap:44px;align-items:start}
  @media (min-width:940px){.cols{grid-template-columns:1.7fr 1fr}}
  article h2{font-size:clamp(1.4rem,2.5vw,1.9rem);margin-top:38px}
  article h2:first-child{margin-top:0}
  .towns{display:flex;flex-wrap:wrap;gap:8px;list-style:none;padding:0;margin:16px 0 8px}
  .towns li{background:var(--green-700);border:1px solid var(--line);border-radius:999px;
            padding:6px 14px;font-size:.9rem}
  .zones{list-style:none;padding:0;margin:14px 0}
  .zones li{padding:9px 0;border-bottom:1px solid var(--line)}
  .zones li:last-child{border-bottom:0}
  .zones span{color:var(--muted)}
  .appt{margin-top:14px}
  .appt strong{color:var(--gold)}
  .glist{list-style:none;padding:0;margin:16px 0}
  .glist li{display:flex;flex-wrap:wrap;gap:4px 12px;align-items:baseline;
            padding:11px 0;border-bottom:1px solid var(--line)}
  .glist li:last-child{border-bottom:0}
  .glist a{font-weight:700;text-decoration:none}
  .glist a:hover{text-decoration:underline}
  .gsun{color:var(--muted);font-size:.84rem}
  .gprice{margin-left:auto;color:var(--gold);font-size:.88rem;font-weight:600;white-space:nowrap}
  aside address{font-style:normal;margin:0 0 18px}
  aside address a{color:var(--gold);text-decoration:none;line-height:1.5}
  aside address a:hover{text-decoration:underline}
  aside h4{margin:26px 0 10px;font-size:.72rem;letter-spacing:.13em;
           text-transform:uppercase;color:var(--muted)}
  .others{list-style:none;padding:0;margin:0}
  .others li{display:flex;justify-content:space-between;gap:10px;padding:7px 0;font-size:.92rem}
  .others a{text-decoration:none}
  .others a:hover{text-decoration:underline}
  .others span{color:var(--muted);font-size:.8rem}
</style>
