---
import Base from '../layouts/Base.astro';
import { site } from '../data/site.js';
---
<Base
  title="Page not found"
  description="That page does not exist. Find grasses, locations, turf tips, or get a sod quote from Buena Vista Turf Farm."
  noindex={true}
>
  <section class="nf"><div class="wrap">
    <span class="eyebrow">404</span>
    <h1>That page is not here.</h1>
    <p class="lede">
      The link may be old or mistyped. If you were pricing a job, the calculator is
      still one click away — or call and someone will sort it out.
    </p>
    <div class="nf-cta">
      <a href="/quote" class="btn">Build Your Quote</a>
      <a href={site.phoneHref} class="btn btn-ghost">Call {site.phone}</a>
    </div>
  </div></section>

  <section><div class="wrap">
    <h2>Try one of these.</h2>
    <div class="grid g3" style="margin-top:40px">
      <a class="card lnk" href="/grasses"><h3>Grasses</h3><p>Bermuda, Zoysia, and St Augustine — what suits sun, shade, and traffic.</p></a>
      <a class="card lnk" href="/locations"><h3>Locations</h3><p>Four North Texas farms and the areas each one serves.</p></a>
      <a class="card lnk" href="/turf-tips"><h3>Turf Tips</h3><p>Getting new sod through its first 30 days.</p></a>
      <a class="card lnk" href="/managers-pictures"><h3>Managers Pictures</h3><p>Weekly field photos and the team behind them.</p></a>
      <a class="card lnk" href="/about-us"><h3>About Us</h3><p>Who we are and how we run the farm.</p></a>
      <a class="card lnk" href="/contact"><h3>Contact</h3><p>Reach a person who knows the field and the schedule.</p></a>
    </div>
  </div></section>
</Base>

<style>
  .nf { background: linear-gradient(135deg, #24462c, #0f1f12); padding: clamp(60px, 9vw, 120px) 0; padding-top: calc(var(--topbar-h, 132px) + clamp(36px, 5vw, 72px)); }
  .nf-cta { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 32px; }
  .lnk { text-decoration: none; display: block; transition: border-color .15s ease, transform .15s ease; }
  .lnk:hover { border-color: var(--brand); transform: translateY(-3px); }
</style>
