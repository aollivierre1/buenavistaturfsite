---
import Base from '../layouts/Base.astro';
import { locations } from '../data/locations.js';
---
<Base
  title="Admin"
  description="Private dashboard for Buena Vista Turf Farm."
  noindex={true}
>
  <section class="ph"><div class="wrap">
    <span class="eyebrow">Private</span>
    <h1>Dashboard.</h1>
    <p class="lede">Job applications, quote requests and contact messages — one at a time, with a record of what you have already handled.</p>
  </div></section>

  <section><div class="wrap">
    <div id="gate" class="card gate">
      <h2>Sign in</h2>
      <p>This page is for the Buena Vista team.</p>
      <form id="loginForm">
        <label for="pw">Password</label>
        <input type="password" id="pw" autocomplete="current-password" required />
        <button type="submit" class="btn">Sign in</button>
      </form>
      <p id="loginErr" class="err" hidden></p>
    </div>

    <div id="panel" hidden>
      <div class="viewbar">
        <div class="tabs">
          <button type="button" class="tab on" data-view="inbox">Inbox</button>
          <button type="button" class="tab" data-view="jobs">Open roles</button>
        </div>
        <button type="button" class="btn btn-ghost" id="outBtn">Sign out</button>
      </div>

      <div id="view-inbox">
        <p id="inboxNote" class="note" hidden></p>
        <div class="tiles" id="tiles"></div>

        <div class="bar">
          <div class="tabs" id="tabs" role="tablist"></div>
          <div class="bar-right">
            <input type="search" id="search" placeholder="Search name, email, phone..." aria-label="Search submissions" />
            <button type="button" class="btn btn-ghost" id="csvBtn">Export CSV</button>
          </div>
        </div>

        <div class="chips" id="chips"></div>

        <div id="reader" hidden>
          <div class="rnav">
            <button type="button" class="navb" id="prevBtn" aria-label="Previous">&#8592;&nbsp; Previous</button>
            <span class="rcount" id="rcount"></span>
            <button type="button" class="navb" id="nextBtn" aria-label="Next">Next &nbsp;&#8594;</button>
          </div>

          <article class="rec" id="rec"></article>

          <div class="ract" id="ract"></div>
          <p class="kbd">Tip: use the <kbd>&#8592;</kbd> and <kbd>&#8594;</kbd> arrow keys to move between people, and <kbd>R</kbd> to mark one reviewed.</p>
        </div>

        <p class="empty" id="emptyMsg" hidden></p>

        <details class="queue" id="queueWrap">
          <summary id="queueSum">Jump to someone else</summary>
          <div id="queue"></div>
        </details>
      </div>

      <div id="view-jobs" hidden>
        <p class="meta">Roles you switch on here appear on the Careers page and in its application form. Changes go live as soon as you save — no redeploy.</p>
        <div id="jobs"></div>
        <div class="jobs-actions">
          <button type="button" class="btn btn-ghost" id="addJob">Add a role</button>
          <button type="button" class="btn" id="saveJobs">Save changes</button>
          <span class="meta" id="jobsMsg"></span>
        </div>
      </div>
    </div>
  </div></section>
</Base>

<script type="application/json" id="bvt-locations" set:html={JSON.stringify(locations.map((l) => l.name + ', ' + l.county))}></script>

<style>
  .ph { background: linear-gradient(135deg,#24462c,#0f1f12); padding: clamp(60px,9vw,120px) 0; padding-top: calc(var(--topbar-h, 132px) + clamp(36px, 5vw, 72px)); }
  .gate { max-width: 420px; }
  .gate form { display: grid; gap: 10px; margin-top: 18px; }
  .gate label { font-size: .7rem; letter-spacing: .13em; text-transform: uppercase; color: var(--muted); }
  input[type=password], input[type=search], input[type=text], textarea, select {
    background: var(--green-900); border: 1px solid var(--line); color: var(--cream);
    padding: 11px 13px; font: inherit; font-size: .93rem; width: 100%;
  }
  /* iOS Safari zooms the page whenever a focused field is under 16px, which
     makes signing in on a phone a fight. The public forms already use 16px. */
  @media (max-width: 640px) {
    input[type=password], input[type=search], input[type=text], textarea, select { font-size: 16px; }
  }
  textarea { min-height: 76px; resize: vertical; }
  :focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }
  .err { color: #ff9c8a; margin-top: 12px; }
  .note { margin: 0 0 18px; padding: 12px 14px; border-left: 3px solid #d8b25e;
    background: rgba(216,178,94,0.09); color: #e6e2d4; font-size: 0.9rem; line-height: 1.55; }

  .viewbar { display: flex; flex-wrap: wrap; gap: 14px; justify-content: space-between; align-items: center; margin-bottom: 30px; }
  .tabs { display: flex; gap: 8px; flex-wrap: wrap; }
  .tab { background: transparent; border: 1px solid var(--line); color: var(--cream); padding: 9px 15px; font-size: .7rem; font-weight: 700; letter-spacing: .11em; text-transform: uppercase; cursor: pointer; }
  .tab.on { background: var(--gold); color: #0f1f12; border-color: var(--gold); }

  .tiles { display: grid; grid-template-columns: repeat(auto-fit,minmax(150px,1fr)); gap: 14px; margin-bottom: 30px; }
  .bar { display: flex; flex-wrap: wrap; gap: 14px; justify-content: space-between; align-items: center; margin-bottom: 16px; }
  .bar-right { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
  .bar-right input { width: auto; min-width: 220px; }
  .meta { color: var(--muted); font-size: .82rem; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 22px; }

  .rnav { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 14px; }
  .rcount { font-size: .72rem; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); text-align: center; }
  .navb { background: transparent; border: 1px solid var(--line); color: var(--cream); padding: 11px 18px;
    font-size: .7rem; font-weight: 700; letter-spacing: .11em; text-transform: uppercase; cursor: pointer; white-space: nowrap; }
  .navb:hover:not(:disabled) { border-color: var(--gold); color: var(--gold); }
  .navb:disabled { opacity: .35; cursor: default; }

  .rec { border: 1px solid var(--line); background: var(--green-700); padding: clamp(20px,3vw,32px); }
  .ract { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; justify-content: space-between; margin-top: 16px; }
  .kbd { color: var(--muted); font-size: .76rem; margin-top: 14px; }
  .kbd kbd { background: var(--green-900); border: 1px solid var(--line); padding: 1px 6px; font-size: .9em; }
  .empty { color: var(--muted); padding: 40px 0; text-align: center; }

  .queue { margin-top: 30px; border-top: 1px solid var(--line); padding-top: 16px; }
  .queue summary { cursor: pointer; font-size: .7rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }
  .queue summary:hover { color: var(--cream); }
  .jobs-actions { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; margin-top: 20px; }
</style>

<!-- Everything below is drawn by the script with innerHTML, and Astro's scoped
     styles only reach elements that exist in the template - it compiles
     ".tile" to ".tile[data-astro-cid-...]" and injected nodes never carry that
     attribute. Scoped rules for these left the whole dashboard - tiles, every
     submission, the job editor - rendering as unstyled text. Namespaced under
     #panel so going global here cannot leak into the rest of the site. -->
<style is:global>
  #panel .tile { border: 1px solid var(--line); background: var(--green-700); padding: 18px 20px; }
  #panel .tile b { display: block; font-family: var(--font-display); font-size: 2.1rem; line-height: 1; }
  #panel .tile span { display: block; margin-top: 8px; font-size: .68rem; letter-spacing: .15em; text-transform: uppercase; color: var(--muted); }
  #panel .tile.hot b { color: var(--gold); }

  #panel .tab { background: transparent; border: 1px solid var(--line); color: var(--cream); padding: 9px 15px;
    font-size: .7rem; font-weight: 700; letter-spacing: .11em; text-transform: uppercase; cursor: pointer; }
  #panel .tab.on { background: var(--gold); color: #0f1f12; border-color: var(--gold); }

  #panel .chip { background: transparent; border: 1px solid var(--line); color: var(--muted); padding: 8px 14px;
    font-size: .68rem; font-weight: 700; letter-spacing: .11em; text-transform: uppercase; cursor: pointer; }
  #panel .chip.on { border-color: var(--gold); color: var(--gold); background: rgba(216,178,94,.1); }

  /* One person's record. Name and status first, then the details in a plain
     two-column list that stays readable on a phone and prints on white. */
  #panel .rec-top { display: flex; flex-wrap: wrap; gap: 10px 18px; align-items: baseline; justify-content: space-between; }
  #panel .rec-name { font-family: var(--font-display); font-size: clamp(1.4rem,3vw,2rem); line-height: 1.15; margin: 0; }
  #panel .rec-role { color: var(--gold); font-size: 1.02rem; font-weight: 700; margin: 8px 0 0; letter-spacing: .01em; }
  #panel .rec-when { color: var(--muted); font-size: .8rem; margin: 5px 0 0; }
  #panel .pill { font-size: .62rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; padding: 5px 11px; border: 1px solid; white-space: nowrap; }
  #panel .pill-new { color: var(--gold); border-color: var(--gold); background: rgba(216,178,94,.12); }
  #panel .pill-done { color: #8fd3a4; border-color: #8fd3a4; background: rgba(143,211,164,.12); }
  #panel .pill-gone { color: #ff9c8a; border-color: #ff9c8a; background: rgba(255,156,138,.1); }

  #panel .fields { display: grid; grid-template-columns: 1fr; gap: 0; margin-top: 22px; }
  @media (min-width: 720px) { #panel .fields { grid-template-columns: 1fr 1fr; gap: 0 32px; } }
  #panel .f { border-top: 1px solid var(--line); padding: 11px 0; }
  #panel .f span { display: block; font-size: .62rem; letter-spacing: .15em; text-transform: uppercase; color: var(--muted); }
  #panel .f p { margin: 5px 0 0; font-size: 1rem; overflow-wrap: anywhere; }
  #panel .f a { color: var(--gold); }
  #panel .f-wide { grid-column: 1 / -1; }

  #panel .donebox { display: flex; gap: 10px; align-items: center; cursor: pointer;
    border: 1px solid var(--line); padding: 12px 18px; font-size: .74rem; font-weight: 700;
    letter-spacing: .1em; text-transform: uppercase; color: var(--cream); }
  #panel .donebox:hover { border-color: var(--gold); }
  #panel .donebox input { width: 18px; height: 18px; accent-color: var(--gold); cursor: pointer; }
  #panel .donebox.is-done { border-color: #8fd3a4; color: #8fd3a4; }
  #panel .ract-right { display: flex; flex-wrap: wrap; gap: 8px; }
  #panel .danger { background: transparent; border: 1px solid var(--line); color: #ff9c8a;
    padding: 11px 18px; font-size: .7rem; font-weight: 700; letter-spacing: .11em; text-transform: uppercase; cursor: pointer; }
  #panel .danger:hover { border-color: #ff9c8a; }

  /* The jump list - compact, one row per person, current one marked. */
  #panel .qrow { display: flex; flex-wrap: wrap; gap: 4px 12px; align-items: baseline; width: 100%; text-align: left;
    background: transparent; border: 0; border-bottom: 1px solid var(--line); color: var(--cream);
    padding: 12px 4px; cursor: pointer; font: inherit; font-size: .9rem; }
  #panel .qrow:hover { background: rgba(245,241,228,.05); }
  #panel .qrow.on { background: rgba(216,178,94,.1); box-shadow: inset 3px 0 0 var(--gold); padding-left: 12px; }
  #panel .qrow .qn { font-weight: 700; }
  #panel .qrow .qd { color: var(--muted); font-size: .78rem; margin-left: auto; }
  #panel .qrow .qr { color: var(--gold); font-size: .82rem; }
  #panel .qrow .qs { font-size: .6rem; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }
  #panel .qrow.done .qn { color: var(--muted); font-weight: 400; }

  #panel .job { border: 1px solid var(--line); background: var(--green-700); padding: 20px 22px; margin-bottom: 12px; }
  #panel .job-grid { display: grid; gap: 12px 18px; grid-template-columns: 1fr; }
  @media (min-width: 780px) { #panel .job-grid { grid-template-columns: 2fr 1.4fr 1fr; } }
  #panel .job-grid label { display: block; font-size: .62rem; letter-spacing: .15em; text-transform: uppercase; color: var(--muted); margin-bottom: 5px; }
  #panel .job-wide { grid-column: 1 / -1; }
  #panel .job-foot { display: flex; flex-wrap: wrap; gap: 16px; align-items: center; justify-content: space-between; margin-top: 14px; }
  #panel .live { display: flex; gap: 9px; align-items: center; font-size: .72rem; letter-spacing: .12em; text-transform: uppercase; color: var(--cream); }
  #panel .live input { width: auto; }
  #panel .rm { background: transparent; border: 1px solid var(--line); color: #ff9c8a; padding: 8px 14px;
    font-size: .68rem; letter-spacing: .11em; text-transform: uppercase; cursor: pointer; }
  #panel .empty { color: var(--muted); padding: 40px 0; text-align: center; }

  /* Printing one applicant: the record only, on white, so it files like any
     other HR document. */
  @media print {
    .topbar, .weatherbar, .hdr, .ft, .ph, .skip,
    #panel .viewbar, #panel .tiles, #panel .bar, #panel .chips,
    #panel .rnav, #panel .ract, #panel .kbd, #panel .queue, #panel #view-jobs,
    #panel .note { display: none !important; }
    body { background: #fff !important; color: #000 !important; }
    #panel .rec { border: 0; background: #fff !important; padding: 0; }
    #panel .rec-name, #panel .f p, #panel .rec-role { color: #000 !important; }
    #panel .rec-when, #panel .f span { color: #444 !important; }
    #panel .f { border-top: 1px solid #bbb; }
    #panel .fields { grid-template-columns: 1fr 1fr; }
    #panel .pill { color: #000 !important; border-color: #888 !important; background: none !important; }
  }
</style>

<script>
  const $ = (id) => document.getElementById(id);
  const ADMIN = '/api/admin';
  const JOBS = '/api/openings';
  let forms = [];
  let active = null;
  let openings = [];
  let reviewed = {};
  let removed = {};
  let filter = 'new';
  let cursor = 0;
  // The people you are working through right now, by id. Fixed while you work
  // the batch and only rebuilt when you change form, filter or search. If it
  // re-filtered the moment you ticked someone off, they would disappear and
  // the next person would slide under your finger - one stray tap and you have
  // marked off an applicant you never read.
  let workIds = [];

  const LOCATIONS = JSON.parse($('bvt-locations').textContent || '[]');

  const esc = (s) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
  const pretty = (k) => k.replace(/[_-]+/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
  const when = (iso) => new Date(iso).toLocaleString('en-US', { dateStyle: 'medium', timeStyle: 'short' });
  const day = (iso) => new Date(iso).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });

  // Netlify keeps the honeypot and its own bookkeeping in the payload; the team
  // does not need to see either.
  const HIDE = new Set(['bot-field', 'form-name', 'ip', 'user_agent', 'referrer']);
  const nameOf = (d) => d.name || d.email || d.phone || 'Submission';

  // What an HR reader wants first, in the order they want it. Anything else
  // keeps its own order underneath.
  const FIRST = ['name', 'email', 'phone'];
  const LONG = new Set(['message', 'notes', 'experience', 'cover_letter', 'comments']);
  // What they applied for belongs beside the name, not buried as the fourth of
  // eight identical-looking rows - it is the first thing you need when a stack
  // of applications covers three different jobs. Shown in the header and in the
  // jump list, so it is left out of the field grid below rather than repeated.
  const HEAD = ['role', 'position', 'location'];
  const headline = (d) => HEAD.map((k) => d[k]).filter(Boolean).join(' · ');

  /* ---------- the one-at-a-time reader ---------- */

  function searchHit(s, q) {
    return !q || JSON.stringify(s.data).toLowerCase().includes(q);
  }

  // Everything in the current form, after the search box and the chosen chip.
  function pool(which) {
    const form = forms.find((f) => f.name === active);
    const q = $('search').value.trim().toLowerCase();
    const all = (form ? form.submissions : []).filter((s) => searchHit(s, q));
    const f = which || filter;
    if (f === 'removed') return all.filter((s) => removed[s.id]);
    const live = all.filter((s) => !removed[s.id]);
    if (f === 'new') return live.filter((s) => !reviewed[s.id]);
    if (f === 'done') return live.filter((s) => reviewed[s.id]);
    return live;
  }

  // Re-read the filters and start a fresh batch. Everything that changes what
  // you are looking at calls this; marking someone off deliberately does not.
  function rebuildWork() {
    workIds = pool().map((s) => s.id);
    cursor = 0;
  }

  function working() {
    const form = forms.find((f) => f.name === active);
    if (!form) return [];
    const byId = new Map(form.submissions.map((s) => [s.id, s]));
    return workIds.map((id) => byId.get(id)).filter(Boolean);
  }

  function statusOf(s) {
    if (removed[s.id]) return { cls: 'pill-gone', label: 'Removed' };
    if (reviewed[s.id]) return { cls: 'pill-done', label: 'Reviewed' };
    return { cls: 'pill-new', label: 'Needs review' };
  }

  function fieldRows(data) {
    const entries = Object.entries(data)
      .filter(([k, v]) => !HIDE.has(k) && !HEAD.includes(k) && v !== '' && v != null);
    entries.sort((a, b) => {
      const ia = FIRST.indexOf(a[0]); const ib = FIRST.indexOf(b[0]);
      return (ia < 0 ? 99 : ia) - (ib < 0 ? 99 : ib);
    });
    return entries.map(([k, v]) => {
      const str = String(v);
      const val = /^https?:\/\//.test(str)
        ? '<a href="' + esc(str) + '" target="_blank" rel="noopener">Open attachment</a>'
        : esc(str);
      const wide = LONG.has(k) || str.length > 90 ? ' f-wide' : '';
      return '<div class="f' + wide + '"><span>' + esc(pretty(k)) + '</span><p>' + val + '</p></div>';
    }).join('');
  }

  function renderReader() {
    const list = working();
    if (cursor >= list.length) cursor = Math.max(0, list.length - 1);
    const s = list[cursor];

    $('reader').hidden = !s;
    $('emptyMsg').hidden = Boolean(s);

    if (!s) {
      const q = $('search').value.trim();
      $('emptyMsg').textContent = q ? 'Nothing matches that search.'
        : filter === 'new' ? 'Nothing left to review here. Well done.'
        : filter === 'done' ? 'Nothing marked reviewed yet.'
        : filter === 'removed' ? 'Nothing removed.'
        : 'No submissions yet.';
      renderQueue(list);
      return;
    }

    const st = statusOf(s);
    $('rec').innerHTML =
      '<div class="rec-top"><div><h2 class="rec-name">' + esc(nameOf(s.data)) + '</h2>' +
      (headline(s.data) ? '<p class="rec-role">' + esc(headline(s.data)) + '</p>' : '') +
      '<p class="rec-when">Submitted ' + esc(when(s.created_at)) + '</p></div>' +
      '<span class="pill ' + st.cls + '">' + st.label + '</span></div>' +
      '<div class="fields">' + fieldRows(s.data) + '</div>';

    $('rcount').textContent = (cursor + 1) + ' of ' + list.length;
    $('prevBtn').disabled = cursor === 0;
    $('nextBtn').disabled = cursor >= list.length - 1;

    const isDone = Boolean(reviewed[s.id]);
    const gone = Boolean(removed[s.id]);
    $('ract').innerHTML = gone
      ? '<button type="button" class="btn" id="restoreBtn">Put back in the list</button>' +
        '<div class="ract-right">' +
        '<button type="button" class="btn btn-ghost" id="printBtn">Print</button>' +
        '<button type="button" class="danger" id="destroyBtn">Delete permanently</button></div>'
      : '<label class="donebox' + (isDone ? ' is-done' : '') + '">' +
        '<input type="checkbox" id="doneChk"' + (isDone ? ' checked' : '') + ' />' +
        (isDone ? 'Reviewed' : 'Mark reviewed') + '</label>' +
        '<div class="ract-right">' +
        '<button type="button" class="btn btn-ghost" id="printBtn">Print</button>' +
        '<button type="button" class="danger" id="removeBtn">Remove</button>' +
        '<button type="button" class="btn" id="nextNew">Next to review &#8594;</button></div>';

    wireActions(s);
    renderQueue(list);
  }

  function wireActions(s) {
    const chk = $('doneChk');
    if (chk) chk.addEventListener('change', () => setFlag(s.id, 'reviewed', chk.checked));
    const rm = $('removeBtn');
    if (rm) rm.addEventListener('click', () => setFlag(s.id, 'removed', true));
    const back = $('restoreBtn');
    if (back) back.addEventListener('click', () => setFlag(s.id, 'removed', false));
    const del = $('destroyBtn');
    if (del) del.addEventListener('click', () => destroy(s));
    const pr = $('printBtn');
    if (pr) pr.addEventListener('click', () => window.print());
    const nn = $('nextNew');
    if (nn) nn.addEventListener('click', jumpToNextNew);
  }

  function renderQueue(list) {
    $('queueSum').textContent = list.length > 1 ? 'Jump to someone else (' + list.length + ')' : 'Jump to someone else';
    $('queueWrap').hidden = list.length < 2;
    $('queue').innerHTML = list.map((s, i) => {
      const st = statusOf(s);
      return '<button type="button" class="qrow' + (i === cursor ? ' on' : '') +
        (reviewed[s.id] ? ' done' : '') + '" data-i="' + i + '">' +
        '<span class="qn">' + esc(nameOf(s.data)) + '</span>' +
        (s.data.role ? '<span class="qr">' + esc(s.data.role) + '</span>' : '') +
        '<span class="qs">' + st.label + '</span>' +
        '<span class="qd">' + esc(day(s.created_at)) + '</span></button>';
    }).join('');
    $('queue').querySelectorAll('.qrow').forEach((b) => b.addEventListener('click', () => {
      cursor = Number(b.dataset.i);
      renderReader();
      $('rec').scrollIntoView({ behavior: 'smooth', block: 'start' });
    }));
  }

  function jumpToNextNew() {
    const list = working();
    const next = list.findIndex((s, i) => i > cursor && !reviewed[s.id] && !removed[s.id]);
    cursor = next >= 0 ? next : Math.min(cursor + 1, list.length - 1);
    renderReader();
  }

  // Flip the flag on screen first so the page answers immediately, then save.
  // If the save fails, put it back and say so rather than leaving a tick that
  // means nothing.
  async function setFlag(id, flag, on) {
    const map = flag === 'reviewed' ? reviewed : removed;
    const before = map[id];
    if (on) map[id] = { at: new Date().toISOString() }; else delete map[id];
    renderChrome();
    renderReader();
    try {
      const res = await fetch(ADMIN + '?action=flag', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ id, flag, on }),
      });
      if (!res.ok) throw new Error('save failed');
    } catch {
      if (before) map[id] = before; else delete map[id];
      renderChrome();
      renderReader();
      note('That did not save. Check your connection and try again.');
    }
  }

  async function destroy(s) {
    if (!confirm('Delete this permanently?\n\n' + nameOf(s.data) + '\n\nThis cannot be undone.')) return;
    try {
      const res = await fetch(ADMIN + '?action=destroy&id=' + encodeURIComponent(s.id), { method: 'POST' });
      const body = await res.json().catch(() => ({}));
      if (!res.ok) { note(body.error || 'Could not delete that one.'); return; }
      const form = forms.find((f) => f.name === active);
      if (form) form.submissions = form.submissions.filter((x) => x.id !== s.id);
      delete removed[s.id];
      delete reviewed[s.id];
      renderChrome();
      renderReader();
    } catch {
      note('Could not reach the server.');
    }
  }

  function note(msg) {
    $('inboxNote').textContent = msg;
    $('inboxNote').hidden = !msg;
  }

  /* ---------- counts, form tabs, filter chips ---------- */

  function renderChrome() {
    const all = forms.flatMap((f) => f.submissions);
    const live = all.filter((s) => !removed[s.id]);
    const toRead = live.filter((s) => !reviewed[s.id]).length;
    const weekAgo = Date.now() - 7 * 86400000;

    $('tiles').innerHTML = [
      [toRead, 'Need review', toRead > 0],
      [live.filter((s) => reviewed[s.id]).length, 'Reviewed', false],
      [live.filter((s) => new Date(s.created_at).getTime() > weekAgo).length, 'Last 7 days', false],
      [live.length, 'All submissions', false],
    ].map((r) => '<div class="tile' + (r[2] ? ' hot' : '') + '"><b>' + r[0] + '</b><span>' + r[1] + '</span></div>').join('');

    $('tabs').innerHTML = forms.map((f) => {
      const n = f.submissions.filter((s) => !removed[s.id] && !reviewed[s.id]).length;
      return '<button type="button" class="tab' + (f.name === active ? ' on' : '') + '" data-form="' + esc(f.name) + '">' +
        esc(pretty(f.name)) + (n ? ' (' + n + ')' : '') + '</button>';
    }).join('');
    $('tabs').querySelectorAll('.tab').forEach((b) => b.addEventListener('click', () => {
      active = b.dataset.form;
      rebuildWork();
      renderChrome();
      renderReader();
    }));

    $('chips').innerHTML = [
      ['new', 'Need review'], ['done', 'Reviewed'], ['all', 'All'], ['removed', 'Removed'],
    ].map(([k, label]) => '<button type="button" class="chip' + (filter === k ? ' on' : '') +
      '" data-filter="' + k + '">' + label + ' (' + pool(k).length + ')</button>').join('');
    $('chips').querySelectorAll('.chip').forEach((b) => b.addEventListener('click', () => {
      filter = b.dataset.filter;
      rebuildWork();
      renderChrome();
      renderReader();
    }));
  }

  /* ---------- open roles ---------- */

  function renderJobs() {
    if (!openings.length) {
      $('jobs').innerHTML = '<p class="empty">No roles yet. Add one and it appears on the Careers page.</p>';
      return;
    }
    const opts = LOCATIONS.concat(['Any / wherever needed'])
      .map((l) => '<option value="' + esc(l) + '"></option>').join('');

    $('jobs').innerHTML = openings.map((o, i) => `
      <article class="job" data-i="${i}">
        <div class="job-grid">
          <div>
            <label for="t${i}">Role title</label>
            <input type="text" id="t${i}" data-k="title" value="${esc(o.title)}" placeholder="CDL driver" />
          </div>
          <div>
            <label for="l${i}">Location</label>
            <input type="text" id="l${i}" data-k="location" list="bvt-locs" value="${esc(o.location)}" placeholder="Ravenna, Fannin County" />
          </div>
          <div>
            <label for="y${i}">Type</label>
            <input type="text" id="y${i}" data-k="type" value="${esc(o.type)}" placeholder="Full-time" />
          </div>
          <div class="job-wide">
            <label for="s${i}">Short description</label>
            <textarea id="s${i}" data-k="summary" placeholder="What the job involves, hours, what you are looking for.">${esc(o.summary)}</textarea>
          </div>
        </div>
        <div class="job-foot">
          <label class="live"><input type="checkbox" data-k="active" ${o.active ? 'checked' : ''} /> Show on Careers page</label>
          <button type="button" class="rm" data-rm="${i}">Remove</button>
        </div>
      </article>`).join('') + '<datalist id="bvt-locs">' + opts + '</datalist>';

    $('jobs').querySelectorAll('[data-k]').forEach((el) => {
      el.addEventListener('input', () => {
        const i = Number(el.closest('.job').dataset.i);
        openings[i][el.dataset.k] = el.type === 'checkbox' ? el.checked : el.value;
      });
    });
    $('jobs').querySelectorAll('[data-rm]').forEach((b) => {
      b.addEventListener('click', () => {
        openings.splice(Number(b.dataset.rm), 1);
        renderJobs();
      });
    });
  }

  async function loadJobs() {
    try {
      const res = await fetch(JOBS);
      const body = await res.json().catch(() => ({}));
      openings = body.openings || [];
    } catch { openings = []; }
    renderJobs();
  }

  $('addJob').addEventListener('click', () => {
    openings.push({ title: '', location: '', type: 'Full-time', summary: '', active: true });
    renderJobs();
    const last = $('jobs').querySelector('.job:last-of-type input');
    if (last) last.focus();
  });

  $('saveJobs').addEventListener('click', async () => {
    const keep = openings.filter((o) => String(o.title || '').trim());
    $('jobsMsg').textContent = 'Saving...';
    try {
      const res = await fetch(JOBS, {
        method: 'PUT',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ openings: keep }),
      });
      const body = await res.json().catch(() => ({}));
      if (!res.ok) { $('jobsMsg').textContent = body.error || 'Could not save.'; return; }
      openings = body.openings || keep;
      renderJobs();
      $('jobsMsg').textContent = 'Saved. The Careers page is updated.';
      setTimeout(() => { $('jobsMsg').textContent = ''; }, 4000);
    } catch {
      $('jobsMsg').textContent = 'Could not reach the server.';
    }
  });

  /* ---------- shell ---------- */

  function show(signedIn) {
    $('gate').hidden = signedIn;
    $('panel').hidden = !signedIn;
  }

  function showGateError(msg) {
    show(false);
    if (msg) { $('loginErr').textContent = msg; $('loginErr').hidden = false; }
  }

  document.querySelectorAll('[data-view]').forEach((b) => b.addEventListener('click', () => {
    document.querySelectorAll('[data-view]').forEach((x) => x.classList.toggle('on', x === b));
    $('view-inbox').hidden = b.dataset.view !== 'inbox';
    $('view-jobs').hidden = b.dataset.view !== 'jobs';
  }));

  // "ADMIN_PASSWORD is missing" is true but not actionable - absent, misnamed,
  // and scoped to the wrong deploy context all look the same from here. Ask the
  // function what it can actually see and say which one it is.
  async function explainMissingKey() {
    let d;
    try {
      const r = await fetch(ADMIN + '?action=diagnose');
      if (!r.ok) return null;
      d = await r.json();
    } catch { return null; }
    if (!d || !d.ADMIN_PASSWORD) return null;

    const miss = d.ADMIN_PASSWORD.nearMisses || [];
    if (miss.length) {
      return 'Netlify has this variable spelled "' + miss.join('", "') + '", but the function looks for '
        + 'exactly ADMIN_PASSWORD. Rename it (watch for a trailing space or lowercase letters), '
        + 'then Deploys → Trigger deploy.';
    }
    if (d.ADMIN_PASSWORD.set) {
      return 'ADMIN_PASSWORD is readable now, so this page is running an older copy of the function. '
        + 'Deploys → Trigger deploy, then reload.';
    }
    return 'ADMIN_PASSWORD is not reaching this function. It is running in the "' + d.deployContext
      + '" context and can see ' + d.envKeyCount + ' variables, but not that one. Two usual causes: '
      + 'its Scopes exclude Functions, or it has a per-context value and Production was left blank. '
      + 'Fix it in Netlify → Environment variables, then Deploys → Trigger deploy — '
      + 'editing the variable alone does not update a function that is already deployed.';
  }

  async function load() {
    let res;
    try { res = await fetch(ADMIN + '?action=data'); }
    catch { showGateError('Cannot reach the server. Is the site deployed with functions enabled?'); return; }
    const body = await res.json().catch(() => ({}));
    if (!res.ok) {
      // 401 is the ordinary signed-out case; anything else is worth naming.
      if (res.status === 401) { showGateError(null); return; }
      const detail = res.status === 500 ? await explainMissingKey() : null;
      showGateError(detail || body.error || 'Could not load submissions (' + res.status + ').');
      return;
    }
    forms = body.forms || [];
    reviewed = body.reviewed || {};
    removed = body.removed || {};
    // Applications first when present — that is what the team checks most.
    active = forms.some((f) => f.name === 'application') ? 'application' : (forms[0] && forms[0].name);
    rebuildWork();
    // An empty inbox and an inbox that could not reach older submissions look
    // identical otherwise, and the first is normal while the second is not.
    note(body.notice || body.warning || '');
    show(true);
    renderChrome();
    renderReader();
    loadJobs();
  }

  $('loginForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    $('loginErr').hidden = true;
    const res = await fetch(ADMIN + '?action=login', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ password: $('pw').value }),
    });
    if (res.ok) { $('pw').value = ''; load(); }
    else {
      const b = await res.json().catch(() => ({}));
      $('loginErr').textContent = b.error || 'Sign in failed.';
      $('loginErr').hidden = false;
    }
  });

  $('outBtn').addEventListener('click', async () => { await fetch(ADMIN + '?action=logout'); show(false); });
  $('search').addEventListener('input', () => { rebuildWork(); renderChrome(); renderReader(); });
  $('prevBtn').addEventListener('click', () => { if (cursor > 0) { cursor--; renderReader(); } });
  $('nextBtn').addEventListener('click', () => { if (cursor < working().length - 1) { cursor++; renderReader(); } });

  // Arrow keys move through the pile, R marks the current one off - but not
  // while someone is typing in the search box or editing a role.
  addEventListener('keydown', (e) => {
    if ($('panel').hidden || $('view-inbox').hidden) return;
    const t = e.target;
    if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.isContentEditable)) return;
    if (e.key === 'ArrowLeft' && cursor > 0) { cursor--; renderReader(); }
    else if (e.key === 'ArrowRight' && cursor < working().length - 1) { cursor++; renderReader(); }
    else if (e.key === 'r' || e.key === 'R') {
      const s = working()[cursor];
      if (s && !removed[s.id]) setFlag(s.id, 'reviewed', !reviewed[s.id]);
    }
  });

  $('csvBtn').addEventListener('click', () => {
    const subs = working();
    if (!subs.length) return;
    const cols = [...new Set(subs.flatMap((s) => Object.keys(s.data)))].filter((c) => !HIDE.has(c));
    const cell = (v) => '"' + String(v ?? '').replace(/"/g, '""') + '"';
    const rows = [['submitted', 'status'].concat(cols).map(cell).join(',')];
    for (const s of subs) {
      rows.push([s.created_at, statusOf(s).label].concat(cols.map((c) => s.data[c])).map(cell).join(','));
    }
    const url = URL.createObjectURL(new Blob([rows.join('\n')], { type: 'text/csv' }));
    const a = document.createElement('a');
    a.href = url;
    a.download = active + '-submissions.csv';
    a.click();
    URL.revokeObjectURL(url);
  });

  load();
</script>
