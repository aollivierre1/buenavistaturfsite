---
import Base from '../layouts/Base.astro';
---
<Base title="Managers Pictures" description="Weekly field photos from Buena Vista Turf Farm — healthy fields, clean harvests, and finished customer sites.">
  <section class="ph"><div class="wrap">
    <span class="eyebrow">Field Notes / Weekly Uploads</span>
    <h1>Proof, posted weekly.</h1>
    <p class="lede">Healthy fields, clean harvests, dependable deliveries, and finished customer sites — photographed by the managers who run them.</p>
  </div></section>
  <section><div class="wrap">
    <div class="card" style="text-align:center;padding:64px 32px">
      <h3>Photo gallery pending image migration</h3>
      <p style="max-width:56ch;margin:0 auto">The weekly field photos live on the current host and need to be moved over. Once the image library is transferred, this page becomes the running gallery again.</p>
    </div>
  </div></section>
</Base>
<style>.ph{background:linear-gradient(135deg,#24462c,#0f1f12);padding:clamp(60px,9vw,120px) 0}</style>
