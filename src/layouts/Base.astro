---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, socials, analytics } from '../data/site.js';
import { locations } from '../data/locations.js';

const { title, description = site.description, image = '/og.jpg', noindex = false,
        extraSchema = null } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | North Texas Sod & Turf Delivery`;
const chatbaseSnippet = analytics.chatbase
  ? '(function(){if(!window.chatbase||window.chatbase("getState")!=="initialized"){window.chatbase=(...a)=>{if(!window.chatbase.q){window.chatbase.q=[]}window.chatbase.q.push(a)};window.chatbase=new Proxy(window.chatbase,{get(t,p){if(p==="q"){return t.q}return(...ar)=>t(p,...ar)}})}var onLoad=function(){var s=document.createElement("script");s.src="https://www.chatbase.co/embed.min.js";s.id="'
    + analytics.chatbase
    + '";s.domain="www.chatbase.co";document.body.appendChild(s)};if(document.readyState==="complete"){onLoad()}else{window.addEventListener("load",onLoad)}})();'
  : null;

const canonical = new URL(Astro.url.pathname, site.url).href;

// Street address and ZIP included: a locality on its own is too weak for Google
// to match the site against the Google Business Profile with any confidence.
const postal = (l) => ({
  '@type': 'PostalAddress',
  streetAddress: l.street,
  addressLocality: l.city || l.name,
  addressRegion: 'TX',
  postalCode: l.zip,
  addressCountry: 'US',
});
const primary = locations.find((l) => l.primary) || locations[0];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: site.name,
  description: site.description,
  url: site.url,
  image: new URL("/og.jpg", site.url).href,
  telephone: site.phone,
  sameAs: socials.map((s) => s.href),
  // Trade bodies the farm belongs to. Google treats memberOf as a credibility
  // signal for a local business, and it costs nothing to state here what the
  // trust bar already says on the page.
  memberOf: site.credentials.map((c) => ({
    '@type': 'Organization',
    name: c.label,
    url: c.url,
  })),
  // Google reads this for the "Hours" line in a local result and for the
  // open/closed state it shows against the business. Days not listed read as
  // closed, which is correct - the farms are weekdays only.
  openingHoursSpecification: [{
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: site.hours.days,
    opens: site.hours.opens,
    closes: site.hours.closes,
  }],
  areaServed: site.serviceArea.map((a) => ({ '@type': 'Place', name: a })),
  // A LocalBusiness needs one postal address of its own - the `location` list
  // below describes the other sites, but Google reads this one as the
  // business's address and will not show an address at all without it.
  address: postal(primary),
  location: locations.map((l) => ({
    '@type': 'Place',
    name: `${site.shortName} — ${l.name}`,
    address: postal(l),
  })),
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL(image, site.url).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL(image, site.url).href} />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon.png" sizes="512x512" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@700;800;900&family=Inter:wght@400;600;700&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
    {/* Page-specific structured data (JobPosting, Product, FAQPage ...). The
        LocalBusiness block above describes the company on every page; this
        describes the one thing this page is about. */}
    {extraSchema && <script type="application/ld+json" set:html={JSON.stringify(extraSchema)}></script>}
    {analytics.ga4 && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${analytics.ga4}`}></script>
        <script is:inline set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','${analytics.ga4}')`}></script>
      </>
    )}
    {analytics.metaPixel && (
      <>
        <script is:inline set:html={`!function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');fbq('init','${analytics.metaPixel}');fbq('track','PageView')`}></script>
        <noscript set:html={`<img height="1" width="1" style="display:none" alt="" src="https://www.facebook.com/tr?id=${analytics.metaPixel}&ev=PageView&noscript=1"/>`}></noscript>
      </>
    )}
  </head>
  <body>
    <a href="#main" class="skip">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    {chatbaseSnippet && <script is:inline set:html={chatbaseSnippet}></script>}
  </body>
</html>
