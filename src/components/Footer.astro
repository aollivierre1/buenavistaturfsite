---
import { site, nav, socials } from '../data/site.js';
import { locations } from '../data/locations.js';
import { grasses } from '../data/grasses.js';
---
<footer class="ft">
  <div class="wrap ft-grid">
    <div>
      <h2 class="ft-logo">Buena Vista Turf Farm</h2>
      <p class="ft-tag">{site.tagline}</p>
      <p><a href={site.phoneHref} class="ft-phone">{site.phone}</a></p>
      <a href="/quote" class="btn">Get a Quote</a>
    </div>
    <div>
      <h3>Grasses</h3>
      <ul>{grasses.map((g) => <li><a href={`/grasses/${g.slug}`}>{g.name}</a></li>)}</ul>
    </div>
    <div>
      <h3>Locations</h3>
      <ul>{locations.map((l) => <li><a href="/locations">{l.name}, {l.county}</a></li>)}</ul>
    </div>
    <div>
      <h3>Follow</h3>
      <ul>
        {socials.map((s) => <li><a href={s.href} target="_blank" rel="noopener">{s.label}</a></li>)}
      </ul>
    </div>
    <div>
      <h3>Company</h3>
      <ul>{nav.map((i) => <li><a href={i.href}>{i.label}</a></li>)}</ul>
    </div>
  </div>
  <div class="wrap ft-btm">
    <p>&copy; {new Date().getFullYear()} Buena Vista Turf Farm. Serving Dallas-Fort Worth and North Texas.</p>
    <!-- Out of the main nav on purpose - customers have no reason to see it -
         but a real button here, because the team has to be able to find it.
         Passcode-gated and noindexed either way. -->
    <a class="ft-staff" href="/admin" rel="nofollow">
      <span aria-hidden="true">&#128274;</span> Admin Login
    </a>
  </div>
</footer>

<style>
  .ft { background: var(--green-800); border-top: 1px solid var(--line); padding: 72px 0 0; }
  .ft-grid { display: grid; gap: 40px; grid-template-columns: 1fr; }
  @media (min-width: 780px) { .ft-grid { grid-template-columns: 1.5fr repeat(4, 1fr); } }
  .ft-logo { font-size: 1.4rem; margin-bottom: 6px; }
  .ft-tag { color: var(--muted); margin-bottom: 14px; }
  .ft-phone { font-size: 1.35rem; font-family: var(--font-display); font-weight: 800; color: var(--gold); text-decoration: none; }
  .ft h3 { font-size: 0.74rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); margin-bottom: 14px; font-family: var(--font-body); font-weight: 700; }
  .ft ul { list-style: none; padding: 0; margin: 0; }
  .ft li { margin-bottom: 9px; }
  .ft li a { color: var(--cream-dim); text-decoration: none; font-size: 0.92rem; }
  .ft li a:hover { color: var(--cream); text-decoration: underline; }
  .ft-btm { border-top: 1px solid var(--line); margin-top: 56px; padding-top: 24px; padding-bottom: 32px;
    display: flex; flex-wrap: wrap; gap: 10px 24px; align-items: baseline; justify-content: space-between; }
  .ft-btm p { font-size: 0.82rem; color: var(--muted); margin: 0; }
  .ft-staff { display: inline-flex; align-items: center; gap: 8px; white-space: nowrap;
    padding: 10px 18px; border: 1px solid var(--gold); color: var(--gold);
    background: rgba(15,31,18,0.5); text-decoration: none;
    font-size: 0.72rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
    transition: background .15s, color .15s; }
  .ft-staff:hover, .ft-staff:focus-visible { background: var(--gold); color: #0f1f12; }
  .ft-staff:focus-visible { outline: 2px solid var(--cream); outline-offset: 2px; }
</style>
