---
import { site, nav } from '../data/site.js';
---
<div class="topbar" id="topbar">
<div class="weatherbar">
  <div class="wrap wb-inner">
    <span class="wb-label">DFW Weather</span>
    <span id="wx" class="wb-val">—</span>
  </div>
</div>

<header class="hdr">
  <div class="wrap hdr-inner">
    <a href="/" class="logo" aria-label={site.name}>
      <img
        src="/images/buena-vista-horiz-clean-color_9e635de2.webp"
        alt={site.name}
        width="2048"
        height="700"
        fetchpriority="high"
        decoding="async"
      />
    </a>

    <button class="menu-btn" aria-expanded="false" aria-controls="nav" id="menuBtn">Menu</button>

    <nav id="nav" class="nav" aria-label="Main">
      {nav.map((i) => <a href={i.href}>{i.label}</a>)}
      <a href={site.phoneHref} class="ph">{site.phone}</a>
      <a href="/quote" class="btn">Get a Quote</a>
    </nav>
  </div>
</header>
</div>

<style>
  /* The bar sits over the hero photo, so it is translucent rather than solid.
     When scrolled past the hero it goes solid so the nav stays readable. */
  /* A scrim, not a solid bar: the photo still reads through, but the logo and
     nav keep contrast even where the sky behind them is bright. Without this
     the green wordmark vanishes against the sunrise. */
  .topbar { position: absolute; top: 0; left: 0; right: 0; z-index: 50;
    background: linear-gradient(180deg, rgba(9,18,11,0.82) 0%, rgba(9,18,11,0.55) 55%, rgba(9,18,11,0) 100%); }
  .topbar.is-stuck { position: fixed; background-image: none; background-color: var(--green-900); border-bottom: 1px solid var(--line); box-shadow: 0 2px 20px rgba(0,0,0,0.35); }
  .topbar.is-stuck .weatherbar { border-bottom-color: var(--line); }

  .weatherbar { background: rgba(15,31,18,0.34); border-bottom: 1px solid rgba(245,241,228,0.12); backdrop-filter: blur(2px); }
  .wb-inner { display: flex; gap: 14px; align-items: center; justify-content: center; padding: 9px 24px; font-size: 0.76rem; letter-spacing: 0.14em; text-transform: uppercase; font-weight: 700; }
  .wb-label { color: var(--gold); }
  .wb-val { color: var(--cream); }

  .hdr { background: transparent; border-bottom: none; }
  .hdr-inner { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding-top: 16px; padding-bottom: 16px; flex-wrap: wrap; }
  .logo { display: flex; align-items: center; text-decoration: none; }
  /* Wordmark is mid-green, header is near-black — lift the mark off the
     background instead of letting it sink into it. */
  .logo img { height: 52px; width: auto; display: block; filter: brightness(1.32) saturate(1.05) drop-shadow(0 2px 6px rgba(0,0,0,0.75)); }
  @media (max-width: 520px) { .logo img { height: 42px; } }

  .nav { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; justify-content: flex-end; }
  .nav a { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.11em; text-transform: uppercase; text-decoration: none; padding: 11px 13px; border: 1px solid rgba(245,241,228,0.45); color: var(--cream); background: rgba(15,31,18,0.28); text-shadow: 0 1px 3px rgba(0,0,0,0.55); }
  .nav a:hover { background: rgba(15,31,18,0.6); border-color: var(--cream); }
  .nav .ph { border-color: transparent; background: transparent; color: var(--gold); }
  .nav .btn { border-color: transparent; background: var(--brand); text-shadow: none; }
  .nav .btn:hover { background: var(--brand-dark); border-color: transparent; }

  .menu-btn { display: none; background: rgba(15,31,18,0.5); border: 1px solid rgba(245,241,228,0.45); color: var(--cream); padding: 10px 16px; font-size: 0.72rem; letter-spacing: 0.11em; text-transform: uppercase; cursor: pointer; }
  @media (max-width: 1100px) {
    .menu-btn { display: block; }
    .nav { display: none; width: 100%; justify-content: flex-start; padding-bottom: 14px; }
    .nav.open { display: flex; }
  }
</style>

<script>
  // Sections need to know how tall the overlaying bar is so their content
  // does not start underneath it.
  const bar = document.getElementById('topbar');
  const publishHeight = () => document.documentElement.style.setProperty('--topbar-h', bar.offsetHeight + 'px');
  publishHeight();
  addEventListener('resize', publishHeight);

  // Solid background once the hero has scrolled away, or the nav becomes
  // unreadable over page content.
  const onScroll = () => bar.classList.toggle('is-stuck', scrollY > bar.offsetHeight);
  onScroll();
  addEventListener('scroll', onScroll, { passive: true });

  const b = document.getElementById('menuBtn');
  b?.addEventListener('click', () => {
    const n = document.getElementById('nav');
    const open = n.classList.toggle('open');
    b.setAttribute('aria-expanded', String(open));
  });

  // Live DFW conditions via Open-Meteo (no API key, free, no attribution required)
  fetch('https://api.open-meteo.com/v1/forecast?latitude=32.7767&longitude=-96.797&current=temperature_2m,wind_speed_10m,weather_code&temperature_unit=fahrenheit&wind_speed_unit=mph')
    .then((r) => r.json())
    .then((d) => {
      const c = d.current;
      const codes = { 0:'Clear sky',1:'Mainly clear',2:'Partly cloudy',3:'Overcast',45:'Fog',48:'Fog',51:'Light drizzle',61:'Light rain',63:'Rain',65:'Heavy rain',80:'Rain showers',95:'Thunderstorm' };
      const desc = codes[c.weather_code] || 'Current conditions';
      document.getElementById('wx').textContent =
        `${Math.round(c.temperature_2m)}°F  ·  ${desc}  ·  Wind ${Math.round(c.wind_speed_10m)} mph`;
    })
    .catch(() => { document.getElementById('wx').textContent = 'Ravenna · Ivanhoe · Collinsville · Ferris'; });
</script>
