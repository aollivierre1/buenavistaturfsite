---
// Shared chrome for the long application forms: the step rail, the navigation,
// and the styles both packets use. The steps themselves are passed in as the
// slot, each one a <section class="step" data-step="Name">.
const { formName, title, titleEs, intro, steps } = Astro.props;
---
<section class="ph"><div class="wrap">
  <a class="back" href="/careers/">&larr; All open roles</a>
  <span class="eyebrow">Application · Solicitud</span>
  <h1>{title}</h1>
  <p class="lede-es">{titleEs}</p>
  <p class="lede">{intro}</p>
</div></section>

<section><div class="wrap">
  <ol class="rail" id="rail">
    {steps.map((s, i) => (
      <li class={i === 0 ? 'on' : ''} data-rail={i}><span>{i + 1}</span>{s}</li>
    ))}
  </ol>

  <p class="saved" id="saved" hidden>Saved on this device — you can close this and come back.
    <span class="es">Guardado en este dispositivo — puede cerrar y volver.</span></p>

  <form
    id="applyForm"
    name={formName}
    method="POST"
    data-netlify="true"
    netlify-honeypot="bot-field"
    enctype="multipart/form-data"
    action="/thanks"
  >
    <input type="hidden" name="form-name" value={formName} />
    <p hidden><label>Leave blank: <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>

    <slot />

    <div class="nav">
      <button type="button" class="btn btn-ghost" id="backBtn">&larr; Back</button>
      <span class="nav-count" id="navCount"></span>
      <button type="button" class="btn" id="nextBtn">Next &rarr;</button>
      <button type="submit" class="btn" id="sendBtn" hidden>Submit application</button>
    </div>
    <p class="err" id="formErr" hidden></p>
  </form>
</div></section>

<style is:global>
  .lede-es { color: var(--muted); font-style: italic; margin-top: -8px; }

  .rail { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; padding: 0; margin: 0 0 24px; }
  .rail li { display: flex; align-items: center; gap: 8px; padding: 8px 13px; border: 1px solid var(--line);
    font-size: .68rem; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
  .rail li span { display: grid; place-items: center; width: 20px; height: 20px; border-radius: 50%;
    background: var(--line); color: var(--cream); font-size: .64rem; }
  .rail li.on { border-color: var(--gold); color: var(--gold); }
  .rail li.on span { background: var(--gold); color: #0f1f12; }
  .rail li.done span { background: var(--brand); color: #fff; }

  .saved { font-size: .82rem; color: var(--brand); margin: 0 0 18px; }

  .step { display: none; }
  .step.on { display: block; }
  .step > h2 { font-size: 1.35rem; margin-bottom: 4px; }
  .step > .es, .fld .es, .yn .es, .chk .es { color: var(--muted); font-style: italic; }
  .step > .es { display: block; margin-bottom: 22px; }

  .grid { display: grid; gap: 16px 22px; grid-template-columns: 1fr; }
  @media (min-width: 700px) { .grid.two { grid-template-columns: 1fr 1fr; } .grid.three { grid-template-columns: 1fr 1fr 1fr; } }
  .wide { grid-column: 1 / -1; }

  .fld label { display: block; font-size: .7rem; letter-spacing: .12em; text-transform: uppercase;
    color: var(--muted); margin-bottom: 6px; }
  .fld .es { display: block; text-transform: none; letter-spacing: 0; font-size: .92em; }
  .fld input, .fld textarea, .fld select {
    background: var(--green-900); border: 1px solid var(--line); color: var(--cream);
    padding: 12px 13px; font: inherit; font-size: 16px; width: 100%;
  }
  .fld textarea { min-height: 86px; resize: vertical; }
  .fld input:focus-visible, .fld textarea:focus-visible, .fld select:focus-visible { outline: 2px solid var(--brand); outline-offset: 1px; }

  .yn { display: flex; flex-wrap: wrap; gap: 10px 18px; align-items: center; justify-content: space-between;
    border-top: 1px solid var(--line); padding: 13px 0; }
  .yn > span:first-child { flex: 1 1 320px; font-size: .94rem; }
  .yn .opts { display: flex; gap: 6px; }
  .yn .opts label { display: inline-flex; align-items: center; gap: 6px; border: 1px solid var(--line);
    padding: 8px 14px; font-size: .72rem; letter-spacing: .08em; text-transform: uppercase; cursor: pointer; }
  .yn .opts input { accent-color: var(--brand); width: 16px; height: 16px; }
  .yn .opts label:has(input:checked) { border-color: var(--gold); color: var(--gold); }

  .chk { display: flex; gap: 10px; align-items: flex-start; padding: 9px 0; font-size: .92rem; }
  .chk input { width: 19px; height: 19px; flex: none; margin-top: 2px; accent-color: var(--brand); }
  .chkgrid { display: grid; gap: 2px 22px; grid-template-columns: 1fr; }
  @media (min-width: 620px) { .chkgrid { grid-template-columns: 1fr 1fr; } }

  .block { border: 1px solid var(--line); padding: 18px; margin-bottom: 16px; }
  .block > h3 { font-size: .74rem; letter-spacing: .14em; text-transform: uppercase; color: var(--gold); margin-bottom: 14px; }

  .legal { border-left: 3px solid var(--gold); background: rgba(216,178,94,.07); padding: 16px 18px;
    font-size: .9rem; line-height: 1.6; margin-bottom: 18px; }
  .legal p { margin-bottom: 10px; }
  .legal p:last-child { margin-bottom: 0; }
  .legal .es { display: block; color: var(--muted); font-style: italic; margin-top: 8px; font-size: .94em; }

  .doc { border: 1px solid var(--line); background: #fff; padding: 8px; margin-bottom: 16px; }
  .doc img { display: block; width: 100%; height: auto; }
  .doc-cap { font-size: .78rem; color: var(--muted); margin: 8px 0 0; }

  .nav { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; justify-content: space-between;
    margin-top: 28px; padding-top: 20px; border-top: 1px solid var(--line); }
  .nav-count { font-size: .72rem; letter-spacing: .13em; text-transform: uppercase; color: var(--muted); }
  .err { color: #ff9c8a; margin-top: 14px; }
</style>

<script>
  const form = document.getElementById('applyForm');
  const steps = [...form.querySelectorAll('.step')];
  const rail = [...document.querySelectorAll('[data-rail]')];
  const KEY = 'bvt-apply-' + form.getAttribute('name');
  let at = 0;

  function show(i) {
    at = Math.max(0, Math.min(i, steps.length - 1));
    steps.forEach((s, n) => s.classList.toggle('on', n === at));
    rail.forEach((r, n) => {
      r.classList.toggle('on', n === at);
      r.classList.toggle('done', n < at);
    });
    document.getElementById('backBtn').disabled = at === 0;
    document.getElementById('nextBtn').hidden = at === steps.length - 1;
    document.getElementById('sendBtn').hidden = at !== steps.length - 1;
    document.getElementById('navCount').textContent = 'Step ' + (at + 1) + ' of ' + steps.length;
    document.getElementById('formErr').hidden = true;
    window.scrollTo({ top: document.querySelector('.rail').offsetTop - 90, behavior: 'smooth' });
  }

  // Only the step on screen is validated; a required field three steps ahead
  // must not block moving forward, and the browser cannot report a field it is
  // not showing.
  function stepValid() {
    const bad = steps[at].querySelectorAll(':invalid');
    if (!bad.length) return true;
    bad[0].focus();
    if (typeof bad[0].reportValidity === 'function') bad[0].reportValidity();
    const err = document.getElementById('formErr');
    err.textContent = 'Please finish the highlighted answer before moving on. / Complete la respuesta marcada antes de continuar.';
    err.hidden = false;
    return false;
  }

  document.getElementById('nextBtn').addEventListener('click', () => { if (stepValid()) { save(); show(at + 1); } });
  document.getElementById('backBtn').addEventListener('click', () => { save(); show(at - 1); });
  rail.forEach((r, n) => r.addEventListener('click', () => { if (n <= at || stepValid()) { save(); show(n); } }));

  // These forms are long and often filled on a phone between jobs. Keep the
  // answers on the device so a dropped connection or a closed tab does not
  // throw the whole thing away. Never the signature images, and cleared the
  // moment it is submitted.
  function save() {
    try {
      const data = {};
      for (const el of form.elements) {
        if (!el.name || el.type === 'file' || el.type === 'hidden' || el.name === 'bot-field') continue;
        if (el.type === 'checkbox' || el.type === 'radio') { if (el.checked) data[el.name] = (data[el.name] || []).concat(el.value); }
        else if (el.value) data[el.name] = el.value;
      }
      localStorage.setItem(KEY, JSON.stringify({ at, data }));
      const n = document.getElementById('saved');
      n.hidden = false;
    } catch { /* private window, blocked storage - the form still works */ }
  }

  function restore() {
    let saved;
    try { saved = JSON.parse(localStorage.getItem(KEY) || 'null'); } catch { return; }
    if (!saved || !saved.data) return;
    for (const [name, val] of Object.entries(saved.data)) {
      const els = form.elements[name];
      if (!els) continue;
      const list = els instanceof RadioNodeList || els instanceof NodeList ? [...els] : [els];
      for (const el of list) {
        if (el.type === 'checkbox' || el.type === 'radio') el.checked = [].concat(val).includes(el.value);
        else el.value = val;
      }
    }
    document.getElementById('saved').hidden = false;
  }

  form.addEventListener('input', () => { clearTimeout(window.__saveT); window.__saveT = setTimeout(save, 600); });
  form.addEventListener('submit', () => { try { localStorage.removeItem(KEY); } catch {} });

  // A role or site carried in from the Careers page should not have to be typed
  // again.
  const q = new URLSearchParams(location.search);
  for (const [key, field] of [['role', 'position'], ['location', 'work_location']]) {
    const v = q.get(key);
    const el = v && form.elements[field];
    if (el) el.value = v;
  }

  restore();
  show(0);
</script>
